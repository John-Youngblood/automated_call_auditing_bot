# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. `.env` is git-ignored; never commit real keys.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- App -------------------------------------------------------------------
APP_ENV=local
LOG_LEVEL=INFO

# Host ports published by docker compose. Change these if something else on
# your machine already owns 8000 or 5173 (another Vite app, for instance).
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Publicly reachable origin of THIS backend, as seen by the telecom provider.
# Used to build the <Play> MP3 URL and the wss:// media-stream URL returned in
# the webhook response. Locally this is your tunnel (ngrok/cloudflared), NOT
# localhost -- the provider dials in from the public internet.
#   ngrok http 8000  ->  https://<subdomain>.ngrok.app
PUBLIC_BASE_URL=http://localhost:8000

# --- Telephony -------------------------------------------------------------
# twilio -> webhook answers with TwiML (XML)
# vonage -> webhook answers with an NCCO (JSON)
TELEPHONY_PROVIDER=twilio

# Absolute URL of the greeting MP3. Leave blank to serve the bundled
# placeholder from this backend at ${PUBLIC_BASE_URL}/static/greeting.mp3
GREETING_AUDIO_URL=

# Verify the provider actually sent the webhook. Leave false until you have a
# public URL + auth token, then turn it on -- an unauthenticated call webhook
# is an open door for spoofed calls.
VALIDATE_WEBHOOK_SIGNATURE=false
TWILIO_AUTH_TOKEN=

# --- Deepgram (speech-to-text) --------------------------------------------
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en-US

# Audio format the provider sends. Twilio Media Streams = mulaw / 8000 / mono.
STT_ENCODING=mulaw
STT_SAMPLE_RATE=8000
STT_CHANNELS=1

# true  -> synthesize fake transcripts, no API key needed (default for local dev)
# false -> open a real streaming connection to Deepgram
STT_MOCK=true

# --- Moderation ------------------------------------------------------------
# Blocklist and call history. Async driver on purpose: a sync DB call would
# block the event loop that is also pumping call audio.
DATABASE_URL=sqlite+aiosqlite:///./call_screener.db
DATABASE_ECHO=false

# How a blocked caller is turned away.
#   rejected -> caller hears a "not accepting calls" treatment
#   busy     -> busy signal; looks like an ordinary failed call rather than a
#               deliberate block, which is often what you want with a hostile
#               caller who would otherwise keep probing
BLOCKED_CALL_REJECT_REASON=rejected

# Rows returned by the call-history view.
CALL_HISTORY_PAGE_SIZE=100

# Where an accepted call is bridged to. A real deployment would look this up
# per operator rather than using one station number.
AGENT_FORWARD_NUMBER=+15550000000

# --- Dashboard fan-out -----------------------------------------------------
# Per-client outbound buffer. A dashboard that cannot keep up drops its
# oldest events rather than back-pressuring the audio path.
FRONTEND_QUEUE_MAX=250
# Transcript lines retained per call for replay to newly-connected dashboards.
TRANSCRIPT_HISTORY_MAX=400

# Comma-separated. Only needed if the dashboard is NOT served through the
# Vite proxy (the compose setup is same-origin, so CORS is a no-op there).
CORS_ALLOW_ORIGINS=http://localhost:5173

# --- Frontend (build-time; Vite only exposes VITE_* to the browser) --------
# Leave blank to derive from window.location and go through the Vite proxy.
VITE_WS_URL=
VITE_API_BASE_URL=
