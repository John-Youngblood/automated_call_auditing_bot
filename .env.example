# =============================================================================
# Call Screener settings
#
#   cp .env.example .env
#
# Then edit .env. Never commit .env -- it holds your passwords and keys.
#
# REQUIRED  = must be filled in before real phone calls will work.
# Blank     = use the default, or leave that feature off.
# =============================================================================


# --- Basics ------------------------------------------------------------------

# local       your own computer; relaxed safety checks
# production  a real deployment; won't start without DASHBOARD_PASSWORD and a
#             real HOST_PHONE_NUMBER (staging behaves the same way)
APP_ENV=local

# INFO for normal use. DEBUG also logs what each caller said.
LOG_LEVEL=INFO

# REQUIRED. The public web address Twilio uses to reach this app.
# While developing, `make tunnel` fills this in for you.
# localhost only works with `make simulate`, not with real calls.
PUBLIC_BASE_URL=http://localhost:8000

# Ports used by `make up`. Change them if another app already uses them.
BACKEND_PORT=8000
FRONTEND_PORT=5173


# --- Phone numbers -----------------------------------------------------------
# Format: + then country code then number, no spaces or dashes. +15035551234

# REQUIRED. The host's phone. Accepted callers are connected to this number.
# The default is fake, and the app won't start with it outside APP_ENV=local.
HOST_PHONE_NUMBER=+15550000000

# The number listeners call. Shown in the dashboard header so it can be read
# out on air. Blank hides it.
TWILIO_PHONE_NUMBER=


# --- Twilio account ----------------------------------------------------------
# All of these are in the Twilio Console. Without them, the Accept, Reject and
# "Close the line" buttons will fail.

# REQUIRED. Starts with AC.
TWILIO_ACCOUNT_SID=

# Recommended: an API key (starts with SK) and its secret. Easier to revoke
# than the auth token. Leave blank to use the auth token instead.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

# REQUIRED. Used to prove incoming calls really came from Twilio.
# Must be the auth token itself -- an API key secret won't work here.
TWILIO_AUTH_TOKEN=

# Set to true for any real deployment, once PUBLIC_BASE_URL and
# TWILIO_AUTH_TOKEN are filled in. Blocks fake calls from anyone who finds
# your webhook address.
VALIDATE_WEBHOOK_SIGNATURE=false

# Seconds to wait for Twilio before giving up.
TWILIO_API_TIMEOUT_SECONDS=5


# --- Dashboard login ---------------------------------------------------------

# Shared password for signing in to the dashboard. At least 8 characters.
# Blank means no login, which is only allowed when APP_ENV=local.
# Restarting the app signs everyone out.
DASHBOARD_PASSWORD=


# --- What callers hear -------------------------------------------------------
# Each message can be a recording or text read aloud by a computer voice.
# If the *_AUDIO_URL is set and the file exists, that recording plays.
# Otherwise the *_MESSAGE text is spoken. A missing file is warned about when
# the app starts.
#
# A recording can be a full https:// link, or just a file name for a file
# you've put in backend/app/static/ (e.g. greeting.mp3). Use file names while
# developing, since the tunnel address changes every time.

# The computer voice for every spoken message. e.g. Polly.Joanna, Polly.Matthew
TTS_VOICE=Polly.Joanna

# First thing callers hear. It must ask them why they're calling -- the app
# starts listening as soon as it ends.
GREETING_AUDIO_URL=
GREETING_MESSAGE="Thanks for calling the show. Tell us your name and what you'd like to talk about, then stay on the line."

# Music while callers wait on hold. Blank (or a missing file) plays Twilio's
# default hold music.
HOLD_MUSIC_URL=

# Played when you reject a caller, before they're hung up on.
REJECT_AUDIO_URL=
REJECT_MESSAGE="Thanks for calling. We are not able to take you on air this time. Please do try us again on the next show."

# Played to anyone who calls while the line is closed.
CLOSED_LINE_AUDIO_URL=
CLOSED_LINE_MESSAGE="Thanks for calling. We are not taking calls right now. Please try again during the next live show."

# Played to everyone still on hold when you click "Close the line".
CLOSING_AUDIO_URL=
CLOSING_MESSAGE="Thanks for calling. The show has ended for tonight, so we are closing the line. Please call back next time."


# --- Speech recognition ------------------------------------------------------

# phone_call is tuned for phone-quality audio. Leave it unless you have a reason.
SPEECH_MODEL=phone_call
SPEECH_LANGUAGE=en-US

# Seconds of silence before the app decides the caller has finished talking.
# Raise it if callers get cut off mid-sentence. A whole number, 1 or more.
SPEECH_TIMEOUT_SECONDS=3


# --- Call handling -----------------------------------------------------------

# Name of the Twilio hold queue. Created automatically -- no setup needed.
HOLD_QUEUE_NAME=screening

# Is the line open (taking calls) when the app starts?
#   true   a restart during a show keeps taking calls
#   false  starts closed; open it from the dashboard
LINE_OPEN_ON_START=true

# After a restart, ask Twilio who is still on hold and put them back on the
# dashboard. What they originally said can't be recovered. Needs the Twilio
# account settings above.
RECONCILE_ON_STARTUP=true


# --- Office deployment only --------------------------------------------------

# Cloudflare tunnel token, used by `make office`. See docs/office.md.
CLOUDFLARE_TUNNEL_TOKEN=


# --- Advanced: usually leave these alone -------------------------------------

# How many finished calls the Call History tab keeps. Cleared on restart.
CALL_HISTORY_SIZE=200

# How far a slow dashboard can fall behind before its oldest updates are dropped.
FRONTEND_QUEUE_MAX=250

# Leave these as they are unless the dashboard is hosted at a different address
# from the app. None of the setups in this repo need them changed.
CORS_ALLOW_ORIGINS=http://localhost:5173
VITE_WS_URL=
VITE_API_BASE_URL=
