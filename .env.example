# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. `.env` is git-ignored; never commit real keys.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- App -------------------------------------------------------------------
APP_ENV=local
# Applies to this app's own loggers only (third-party libraries stay at
# WARNING, so DEBUG is actually readable). Set DEBUG to log the text of each
# caller's transcript, which INFO deliberately omits -- at INFO you get the
# length and confidence but not the content.
LOG_LEVEL=INFO

# Host ports published by docker compose. Change these if something else on
# your machine already owns 8000 or 5173 (another Vite app, for instance).
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Publicly reachable origin of THIS backend, as seen by the telecom provider.
# Used to build the <Play> MP3 URL and the wss:// media-stream URL returned in
# the webhook response. Locally this is your tunnel (ngrok/cloudflared), NOT
# localhost -- the provider dials in from the public internet.
#   ngrok http 8000  ->  https://<subdomain>.ngrok.app
PUBLIC_BASE_URL=http://localhost:8000

# --- Telephony -------------------------------------------------------------
# Absolute URL of the greeting MP3 -- this is also the prompt, so it must ask
# the caller to say why they are calling. Leave blank to serve the recording
# bundled at ${PUBLIC_BASE_URL}/static/greeting.mp3
GREETING_AUDIO_URL=

# Twilio's speech recognition for <Gather input="speech">. "phone_call" is
# tuned for 8kHz telephony audio; the default model is trained on wideband and
# does noticeably worse down a phone line.
SPEECH_MODEL=phone_call
SPEECH_LANGUAGE=en-US

# Seconds of silence before Twilio decides the caller has finished speaking.
# Must be a positive integer, never "auto": Twilio warns (error 13335) when
# "auto" is paired with a SPEECH_MODEL, and "auto" stops at the FIRST pause,
# which cuts callers off mid-explanation. Raise it if callers are being
# truncated; lower it if the dashboard feels sluggish.
SPEECH_TIMEOUT_SECONDS=3

# Twilio queue that callers wait in while an operator reads their transcript.
# Created on demand -- nothing to set up in the console.
HOLD_QUEUE_NAME=screening

# Absolute URL of ONE audio file to play on hold; Twilio loops it for as long
# as the caller waits. Leave blank for Twilio's default classical playlist.
# Twilio caches the file, so it is fetched once, not once per loop.
#
# To serve your own from this backend, drop it next to the greeting in
# backend/app/static/ and point here at ${PUBLIC_BASE_URL}/static/hold.mp3
# (written out in full -- this file is not shell, nothing interpolates).
HOLD_MUSIC_URL=

# Whether the line accepts calls when the process starts. True keeps a restart
# invisible mid-show, which is the case that matters most -- a deploy must not
# silently stop taking calls while you are on air. Set false for a deployment
# that should come up off-air and be opened by hand. Not persisted either way.
LINE_OPEN_ON_START=true

# Spoken to anyone who calls while the line is closed. Tells them when to try
# again rather than leaving them with silence they will read as a broken
# number. Note <Say> answers the call, so these seconds are billed -- the
# right trade for a show whose callers are its audience.
CLOSED_LINE_MESSAGE="Thanks for calling. We are not taking calls right now. Please try again during the next live show."

# Spoken to anyone still holding when an operator clears the queue at the end
# of a show. They have been waiting to get on air, so they are told rather
# than silently dropped.
CLOSING_MESSAGE="Thanks for calling. The show has ended for tonight, so we are closing the line. Please call back next time."

# Verify the provider actually sent the webhook. Leave false until you have a
# public URL + auth token, then turn it on -- an unauthenticated call webhook
# is an open door for spoofed calls.
#
# Signature checking is HMAC'd with the AUTH TOKEN specifically. An API key
# secret will not validate, which is why this is separate from the REST
# credentials below -- rotate one without breaking the other.
VALIDATE_WEBHOOK_SIGNATURE=false
TWILIO_AUTH_TOKEN=

# --- Twilio REST -----------------------------------------------------------
# Credentials for talking TO Twilio. Needed for startup reconciliation (below)
# and, once it is wired, for bridging an accepted call.
#
# Prefer an API key over the auth token: it can be revoked on its own. Leave
# the key blank to fall back to TWILIO_ACCOUNT_SID + TWILIO_AUTH_TOKEN.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

# Short on purpose -- these calls happen off the webhook path, so a slow
# Twilio should make us give up and log rather than pile up.
TWILIO_API_TIMEOUT_SECONDS=5

# On boot, ask Twilio who is still holding in the queue and put them back on
# the dashboard. Without this a restart mid-show strands every waiting caller:
# Twilio keeps playing them hold music while no operator can see them, and
# nothing ever fires to say they are there.
#
# What comes back: number, name, start time. What does not: the TRANSCRIPT,
# and the city/state labels. Recovered callers are flagged in the UI so an
# operator knows to ask again rather than reading a blank as silence.
# No-op without the credentials above.
RECONCILE_ON_STARTUP=true

# --- Call history ----------------------------------------------------------
# Finished calls kept in memory, and the default page size of the history
# endpoint -- one number, because there is nowhere else for a call to live.
# There is no database: the history view starts empty after every restart.
CALL_HISTORY_SIZE=200

# Where an accepted call is bridged to. A real deployment would look this up
# per operator rather than using one station number.
AGENT_FORWARD_NUMBER=+15550000000

# --- Dashboard fan-out -----------------------------------------------------
# Per-client outbound buffer. A dashboard that cannot keep up drops its
# oldest events rather than back-pressuring the audio path.
FRONTEND_QUEUE_MAX=250

# Comma-separated. Only needed if the dashboard is NOT served through the
# Vite proxy (the compose setup is same-origin, so CORS is a no-op there).
CORS_ALLOW_ORIGINS=http://localhost:5173

# --- Frontend (build-time; Vite only exposes VITE_* to the browser) --------
# Leave blank to derive from window.location and go through the Vite proxy.
VITE_WS_URL=
VITE_API_BASE_URL=
