# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. `.env` is git-ignored; never commit real keys.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- App -------------------------------------------------------------------
APP_ENV=local
# Applies to this app's own loggers only (third-party libraries stay at
# WARNING, so DEBUG is actually readable). Set DEBUG to log the text of each
# caller's transcript, which INFO deliberately omits -- at INFO you get the
# length and confidence but not the content.
LOG_LEVEL=INFO

# Host ports published by docker compose. Change these if something else on
# your machine already owns 8000 or 5173 (another Vite app, for instance).
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Publicly reachable origin of THIS backend, as seen by the telecom provider.
# Used to build the <Play> MP3 URL and the wss:// media-stream URL returned in
# the webhook response. Locally this is your tunnel (ngrok/cloudflared), NOT
# localhost -- the provider dials in from the public internet.
#   ngrok http 8000  ->  https://<subdomain>.ngrok.app
PUBLIC_BASE_URL=http://localhost:8000

# --- What the caller hears -------------------------------------------------
# Every prompt is a pair: an audio file, and text to fall back on. A recording
# wins when one is set; otherwise Twilio speaks the text in TTS_VOICE. So a
# fresh deployment says something sensible with nothing recorded, and you can
# replace each line with real audio one at a time.
#
# Audio settings take an absolute URL, or a bare filename served from
# backend/app/static/. Prefer the filename form in development: PUBLIC_BASE_URL
# is a tunnel hostname that rotates and this file cannot interpolate it. Prefer
# an absolute CDN URL in production, so Twilio is not pulling audio through
# your API.

# Twilio text-to-speech voice for every spoken fallback. Amazon Polly names
# (Polly.Joanna, Polly.Matthew, Polly.Amy, ...) or Twilio's basic man/woman.
# One voice for the whole service: a show that speaks in two different
# synthetic voices sounds broken rather than varied.
TTS_VOICE=Polly.Joanna

# 1. GREETING -- plays inside <Gather>, so it is also the PROMPT. Whatever is
#    said here has to ask the caller to state their reason, or they will sit in
#    silence waiting for a person. Blank falls back to the bundled
#    static/greeting.mp3 if that file exists, then to the text.
GREETING_AUDIO_URL=
GREETING_MESSAGE="Thanks for calling the show. After the beep, tell us your name and what you would like to talk about, then stay on the line."

# 2. HOLD MUSIC -- looped for as long as the caller waits. The one prompt with
#    no text fallback, because it is music: blank means Twilio's own classical
#    playlist, which is better than silence or a robot voice on a loop.
#    Twilio caches the file, so it is fetched once, not once per loop.
HOLD_MUSIC_URL=

# 3. REJECTED -- an operator decided not to put this caller on air. Without
#    this a rejected caller hears nothing at all and holds until they give up,
#    invisible on the dashboard and still being billed.
REJECT_AUDIO_URL=
REJECT_MESSAGE="Thanks for calling. We are not able to take you on air this time. Please do try us again on the next show."

# 4. LINE CLOSED -- someone calls while you are off air. Tells them when to try
#    again rather than leaving a busy signal they will read as a broken number.
CLOSED_LINE_AUDIO_URL=
CLOSED_LINE_MESSAGE="Thanks for calling. We are not taking calls right now. Please try again during the next live show."

# 5. CLOSING -- played to anyone still holding when you close the line. They
#    have been waiting to get on air, so they are told rather than dropped.
CLOSING_AUDIO_URL=
CLOSING_MESSAGE="Thanks for calling. The show has ended for tonight, so we are closing the line. Please call back next time."

# --- Speech recognition ----------------------------------------------------
# "phone_call" is tuned for 8kHz telephony audio; the default model is trained
# on wideband and does noticeably worse down a phone line.
SPEECH_MODEL=phone_call
SPEECH_LANGUAGE=en-US

# Seconds of silence before Twilio decides the caller has finished speaking.
# Must be a positive integer, never "auto": Twilio warns (error 13335) when
# "auto" is paired with a SPEECH_MODEL, and "auto" stops at the FIRST pause,
# which cuts callers off mid-explanation. Raise it if callers are being
# truncated; lower it if the dashboard feels sluggish.
SPEECH_TIMEOUT_SECONDS=3

# --- Call flow -------------------------------------------------------------
# Twilio queue that callers wait in while an operator reads their transcript.
# Created on demand -- nothing to set up in the console.
HOLD_QUEUE_NAME=screening

# Whether the line accepts calls when the process starts. True keeps a restart
# invisible mid-show, which is the case that matters most -- a deploy must not
# silently stop taking calls while you are on air. Set false for a deployment
# that should come up off-air and be opened by hand. Not persisted either way.
LINE_OPEN_ON_START=true

# Verify the provider actually sent the webhook. Leave false until you have a
# public URL + auth token, then turn it on -- an unauthenticated call webhook
# is an open door for spoofed calls.
#
# Signature checking is HMAC'd with the AUTH TOKEN specifically. An API key
# secret will not validate, which is why this is separate from the REST
# credentials below -- rotate one without breaking the other.
VALIDATE_WEBHOOK_SIGNATURE=false
TWILIO_AUTH_TOKEN=

# --- Tunnel (office deployment) --------------------------------------------
# Token for a *named* Cloudflare tunnel, so Twilio can reach this machine
# without opening a port on the router. Only used by
# docker-compose.office.yml -- see docs/office.md.
#
# A named tunnel's hostname never changes, which is the point: Twilio is
# configured once and the machine can reboot freely. `make tunnel` is the
# development alternative and invents a new hostname every run.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Dashboard auth --------------------------------------------------------
# One shared password, exchanged for a session token the browser holds. No
# accounts and no reset flow -- there is one host and a couple of operators.
#
# Blank leaves the dashboard and the whole /api surface open, which the service
# only tolerates when APP_ENV=local. Anywhere else it refuses to start without
# one, and refuses anything shorter than 8 characters.

# Tokens live in memory, so a restart signs everyone out -- which doubles as
# revocation.
DASHBOARD_PASSWORD=

# --- Twilio REST -----------------------------------------------------------
# Credentials for talking TO Twilio. Needed for startup reconciliation (below)
# and, once it is wired, for bridging an accepted call.
#
# Prefer an API key over the auth token: it can be revoked on its own. Leave
# the key blank to fall back to TWILIO_ACCOUNT_SID + TWILIO_AUTH_TOKEN.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

# Short on purpose -- these calls happen off the webhook path, so a slow
# Twilio should make us give up and log rather than pile up.
TWILIO_API_TIMEOUT_SECONDS=5

# On boot, ask Twilio who is still holding in the queue and put them back on
# the dashboard. Without this a restart mid-show strands every waiting caller:
# Twilio keeps playing them hold music while no operator can see them, and
# nothing ever fires to say they are there.
#
# What comes back: number, name, start time. What does not: the TRANSCRIPT,
# and the city/state labels. Recovered callers are flagged in the UI so an
# operator knows to ask again rather than reading a blank as silence.
# No-op without the credentials above.
RECONCILE_ON_STARTUP=true

# --- Call history ----------------------------------------------------------
# Finished calls kept in memory, and the default page size of the history
# endpoint -- one number, because there is nowhere else for a call to live.
# There is no database: the history view starts empty after every restart.
CALL_HISTORY_SIZE=200

# The host's phone, in E.164. Accepting a caller dials this and bridges them
# to it. One number by design: there is one host and one on-air slot.
#
# The default below is a deliberately fake placeholder -- the service refuses
# to start on it outside APP_ENV=local, because shipping with it would send
# every accepted caller nowhere while the dashboard said they were on air.
HOST_PHONE_NUMBER=+15550000000

# --- Dashboard fan-out -----------------------------------------------------
# Per-client outbound buffer. A dashboard that cannot keep up drops its
# oldest events rather than back-pressuring the audio path.
FRONTEND_QUEUE_MAX=250

# Comma-separated. Only needed if the dashboard is NOT served through the
# Vite proxy (the compose setup is same-origin, so CORS is a no-op there).
CORS_ALLOW_ORIGINS=http://localhost:5173

# --- Frontend (build-time; Vite only exposes VITE_* to the browser) --------
# Leave blank to derive both from window.location. That is correct for every
# setup here -- Vite proxies in dev, nginx in the office, and the Cloud Run
# image serves the dashboard from the API itself. Only set these if you host
# the dashboard on a different origin, and set CORS_ALLOW_ORIGINS to match.
VITE_WS_URL=
VITE_API_BASE_URL=
